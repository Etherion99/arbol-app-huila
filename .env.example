# Plantilla de variables de entorno de ÁrbolApp Huila.
# Copiar a .env y rellenar. El archivo .env NO se versiona.
#
# Estado a 20 de agosto de 2026:
#   - Proyecto Supabase: pendiente de crear (región East US, la de menor latencia a Colombia)
#   - API key de Google Maps: pendiente de entrega, dejar el placeholder mientras tanto

# ---------- Supabase ----------
# Panel de Supabase -> Project Settings -> API
EXPO_PUBLIC_SUPABASE_URL=https://PENDIENTE.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=PENDIENTE

NEXT_PUBLIC_SUPABASE_URL=https://PENDIENTE.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=PENDIENTE

# Solo para scripts de administración y Edge Functions. Nunca en el cliente.
SUPABASE_SERVICE_ROLE_KEY=PENDIENTE

# ---------- Google Maps ----------
# Una key por plataforma, cada una restringida a su package name / bundle ID
# (co.edu.iesansebastian.arbolapp) o al dominio del panel web.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=PENDIENTE
EXPO_PUBLIC_GOOGLE_MAPS_IOS_KEY=PENDIENTE
NEXT_PUBLIC_GOOGLE_MAPS_JS_KEY=PENDIENTE
