{
  "name": "arbol-app-huila",
  "version": "0.1.0",
  "private": true,
  "description": "ÁrbolApp Huila — plataforma de geolocalización y seguimiento de árboles frutales del proyecto PRAE \"De la pantalla a la realidad\"",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "^20.19.4 || ^22.13.0 || ^24.3.0 || >=25",
    "pnpm": ">=11"
  },
  "scripts": {
    "mobile": "pnpm --filter @arbolapp/mobile start",
    "mobile:android": "pnpm --filter @arbolapp/mobile android",
    "web": "pnpm --filter @arbolapp/web dev",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff",
    "test:species": "node scripts/check-species-normalization.mjs",
    "test:rls": "node scripts/check-rls.mjs",
    "test:auth": "node scripts/check-auth.mjs",
    "test:merge": "node scripts/check-species-merge.mjs",
    "tokens": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-design-tokens.mjs",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,json,md,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,json,md,yml}\"",
    "sprites": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-marker-sprites.mjs"
  },
  "devDependencies": {
    "prettier": "3.4.2",
    "supabase": "2.115.0"
  }
}
